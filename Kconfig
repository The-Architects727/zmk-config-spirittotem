config TOTEM_BATTERY_LED
    bool "Low-battery LEDs on the Totem dongle for each split half"
    default y
    depends on ZMK_SPLIT_ROLE_CENTRAL
    depends on ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING

config TOTEM_SLEEP_WARN
    bool "Flash the onboard LED before sleeping, and auto-sleep when the central is unreachable"
    default y
    depends on ZMK_SPLIT && !ZMK_SPLIT_ROLE_CENTRAL
    depends on ZMK_PM_SOFT_OFF
